{
	"root": true,
	"extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module"
	},
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"ignorePatterns": [
		"node_modules/",
		"out/",
		".vite/",
		"dist/",
		"test-results/",
		"playwright-report/"
	],
	"overrides": [
		{
			"files": [ "tests/**/*.ts" ],
			"rules": {
				"no-console": "off"
			}
		}
	]
}
